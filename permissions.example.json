{
  "read_only": [
    "Bash(ls *)",
    "Bash(cat *)",
    "Bash(echo *)",
    "Bash(pwd *)",
    "Bash(head *)",
    "Bash(tail *)",
    "Bash(wc *)",
    "Bash(grep *)",
    "Bash(rg *)",
    "Bash(find *)",
    "Bash(which *)",
    "Bash(date *)",
    "Bash(whoami *)",
    "Bash(uname *)",
    "Bash(df *)",
    "Bash(du *)",
    "Bash(stat *)",
    "Bash(file *)",
    "Bash(env *)",
    "Bash(git status *)",
    "Bash(git log *)",
    "Bash(git diff *)",
    "Bash(git show *)",
    "Bash(git branch *)",
    "Bash(git remote *)",
    "Bash(git fetch *)",
    "Bash(docker ps *)",
    "Bash(docker compose ps *)",
    "Bash(docker logs *)",
    "Bash(systemctl --user status *)",
    "Bash(journalctl *)"
  ],
  "dangerous": [
    "\\brm\\b",
    "\\brmdir\\b",
    "\\bdd\\b",
    "\\bmkfs\\b",
    "\\bchmod\\b.*\\s-R\\b|\\bchmod\\s+-R\\b",
    "\\bchown\\b.*\\s-R\\b|\\bchown\\s+-R\\b",
    "\\b(curl|wget)\\b.*\\|\\s*(ba|z)?sh\\b",
    "\\bsudo\\b",
    "\\bkill\\b|\\bpkill\\b|\\bkillall\\b",
    "\\bshutdown\\b|\\breboot\\b",
    "\\bsystemctl\\b.*\\b(stop|disable|restart|mask)\\b",
    "\\bcrontab\\s+-r\\b",
    "\\bgit\\b.*\\b(push|reset\\s+--hard|clean\\b|branch\\s+-D|checkout\\s+\\.|restore\\s+\\.)",
    "\\bgh\\s+pr\\s+merge\\b|\\bglab\\s+mr\\s+merge\\b",
    "\\bdocker\\b.*\\b(rm|rmi|prune|compose\\s+down|stop|kill)\\b",
    "\\bkubectl\\b.*\\b(delete|apply|drain)\\b",
    "\\bterraform\\s+(apply|destroy)\\b",
    "\\boci\\b.*\\b(terminate|delete|update)\\b",
    "\\bdrop\\s+(table|database|schema|index)\\b",
    "\\btruncate\\b",
    "\\bdelete\\s+from\\b",
    "\\b(mysql|psql|redis-cli|mongosh)\\b",
    "\\bssh\\b|\\bscp\\b|\\brsync\\b",
    "\\bdeploy\\b|\\bmigrate\\b"
  ],
  "sensitive_paths": [
    "*/.env",
    "*/.env.*",
    "*/.ssh/*",
    "*/.gnupg/*",
    "*/.aws/*",
    "*/.kube/*",
    "*/.claude/settings*.json",
    "*/.claude.json",
    "*/projects.json",
    "*/permissions.json",
    "*.pem",
    "*.key",
    "*/id_rsa*",
    "*/id_ed25519*",
    "*secret*",
    "*credential*",
    "/etc/*",
    "*/.git/hooks/*",
    "*/.git/config"
  ]
}
