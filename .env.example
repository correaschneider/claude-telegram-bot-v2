# ---- Telegram (obrigatório) ----
TELEGRAM_TOKEN=
# IDs de chat autorizados, separados por vírgula
ALLOWED_CHAT_IDS=

# ---- Claude Code ----
# Diretório de trabalho das sessões (obrigatório)
WORKSPACE=
CLAUDE_BIN=claude
# Usado quando /yolo está desligado
CLAUDE_PERMISSION_MODE=acceptEdits
# --allowedTools (usado quando /yolo está desligado). Ex.: Read Edit Write Glob Grep Bash(git:*)
CLAUDE_ALLOWED_TOOLS=
# --add-dir extras, separados por vírgula
CLAUDE_ADD_DIRS=
# Texto anexado ao system prompt (vazio = default do bot)
CLAUDE_APPEND_SYSTEM_PROMPT=

# ---- Sessão ----
SESSIONS_FILE=
# Sessão parada além disso reseta sozinha (default 6h)
SESSION_TTL_SECONDS=21600

# ---- Streaming (sendMessageDraft) ----
# Intervalo mínimo entre atualizações do rascunho (rate limit do Telegram)
DRAFT_INTERVAL_SECONDS=1.5
# Reenvia o rascunho mesmo sem mudança (o Telegram apaga rascunho parado ~30s)
DRAFT_KEEPALIVE_SECONDS=10
# Janela deslizante do rascunho (limite da API: 4096)
DRAFT_MAX_CHARS=3500
