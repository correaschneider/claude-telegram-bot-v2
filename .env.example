# ---- Telegram (obrigatório) ----
TELEGRAM_TOKEN=
# Chats atendidos (privados e grupos), separados por vírgula
ALLOWED_CHAT_IDS=
# Quem pode disparar em grupo/guest e aprovar permissões (default: os ids positivos acima)
ALLOWED_USER_IDS=

# ---- Claude Code ----
# Diretório usado quando não há projects.json (obrigatório)
WORKSPACE=
PROJECTS_FILE=
CLAUDE_BIN=claude
# Defaults quando o projeto não define os seus
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=
CLAUDE_ADD_DIRS=
# Texto anexado ao system prompt (vazio = default do bot, que inclui a instrução da checklist)
CLAUDE_APPEND_SYSTEM_PROMPT=

# ---- Conversas / sessões ----
STORE_FILE=
# Sessão parada além disso reseta sozinha (default 6h)
SESSION_TTL_SECONDS=21600
# Duração padrão do /yolo (default 1h)
YOLO_TTL_SECONDS=3600

# ---- Apresentação ----
DRAFT_INTERVAL_SECONDS=1.5
DRAFT_KEEPALIVE_SECONDS=10
DRAFT_MAX_CHARS=3500
# Rich Messages (Bot API 10.1+) na resposta final e na checklist; false = só HTML
RICH_MESSAGES=true
# Rodapé mostra tokens (↓entrada ↑saída); true adiciona também o custo em USD
FOOTER_COST=false
# Tag que torna a resposta pública em grupo (senão é efêmera pro autor)
GROUP_PUBLIC_TAG=#todos

# ---- Agendamentos (tool mcp__tg__schedule) ----
JOBS_FILE=
DEFAULT_TZ=America/Sao_Paulo

# ---- Voz / imagem ----
# Servidor WhisperX residente (deploy/whisperx_server.py, ~0,5 s/áudio). Vazio = só CLI (~10 s)
WHISPERX_SERVER_URL=http://127.0.0.1:8765
# CLI de fallback compatível com o WhisperX (default: ~/.local/bin/whisperx-cli)
WHISPERX_BIN=
WHISPERX_MODEL=large-v3
# cuda (default) ou cpu
WHISPERX_DEVICE=cuda
WHISPERX_LANGUAGE=pt
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH=8
# Serializa transcrições (VRAM). Vazio = sem lock; ignorado se não houver `flock`
WHISPERX_LOCK=/tmp/whisperx-pipeline.lock
AUDIO_TMP_DIR=/tmp/telegram-audio
IMAGE_TMP_DIR=/tmp/telegram-images

# ---- Bridge MCP (aprovações, perguntas, checklist, arquivos, agendamentos) ----
BRIDGE_HOST=127.0.0.1
# 0 = porta livre aleatória
BRIDGE_PORT=0
# Quanto o Claude espera uma aprovação humana (default 24h)
MCP_TOOL_TIMEOUT_MS=86400000
